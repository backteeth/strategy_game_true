// P32-012 (M4-D) 検証用のプロヴィンス別天然資源(入力の正本)。**正式な資源分布・ゲームバランスではない。**
// `province_resources.ron`(P32-009)と同じ形式・意味。M4-D の検証シナリオ(`economy_scenario_m4d.ron`)用に、
// 検証地域の全プロヴィンスを設定済みにしている(Mineを持つ・Mineを建てうるステートは全プロヴィンスの設定が必須)。
// `deposits: []` は「資源なし(明示)」。通常の地理プレビューや旧ゲームには注入されない。
// scope: Partial = 検証地域だけ(全世界の資源配置が完了したことを意味しない)。
(
    format_version: 1,
    scope: Partial,
    provinces: [
        // ── MapState#20: Iron 25 + 15 = 40、Coal 30(P32-009と同じ)。
        (province: 18109, deposits: []),
        (province: 18308, deposits: []),
        (province: 18309, deposits: [(resource_type: Iron, base_output: 25.0, discovered: true, development_level: 1)]),
        (province: 18310, deposits: [(resource_type: Iron, base_output: 15.0, discovered: true, development_level: 2)]),
        (province: 18311, deposits: [(resource_type: Coal, base_output: 30.0, discovered: true, development_level: 1)]),
        (province: 18499, deposits: []),
        (province: 18500, deposits: []),
        // ── MapState#21: Iron 20 + 25 = 45(発見済み)+ 未発見の Iron 12。
        (province: 17269, deposits: []),
        (province: 17486, deposits: []),
        (province: 17487, deposits: []),
        (province: 17694, deposits: [(resource_type: Iron, base_output: 20.0, discovered: true, development_level: 1)]),
        (province: 17695, deposits: [(resource_type: Iron, base_output: 12.0, discovered: false, development_level: 1)]),
        (province: 17696, deposits: [(resource_type: Iron, base_output: 25.0, discovered: true, development_level: 1)]),
        (province: 17904, deposits: []),
        (province: 17905, deposits: []),
        (province: 17906, deposits: []),
        (province: 18111, deposits: []),
        (province: 18112, deposits: []),
        (province: 18312, deposits: []),
        (province: 18502, deposits: []),
        // ── MapState#22: Iron 40(発見済み)。
        (province: 17266, deposits: [(resource_type: Iron, base_output: 40.0, discovered: true, development_level: 1)]),
        (province: 17267, deposits: []),
        (province: 17268, deposits: []),
        (province: 17484, deposits: []),
        (province: 17485, deposits: []),
        (province: 17693, deposits: []),
        // ── どのステートにも属さないプロヴィンス(設定済み・資源なし。架空のステートへは集計されない)。
        (province: 17903, deposits: []),
        (province: 18110, deposits: []),
        (province: 18501, deposits: []),
    ],
)
