// P32-007 (M4-A) 検証用の経済シナリオ。**正式な人口分布・施設配置・ゲームバランスではない。**
// 地理配置(provinces.ron / states.ron)とは別のデータ。通常の地理プレビューや旧ゲームには注入されない。
// 読み取り専用の検証経路 `cargo run --bin world_economy_check` と自動テストだけが使う。
// state は provinces/states.ron の MapStateId(20/21/22)。旧 StateId とは無関係。
(
    format_version: 1,
    description: "P32-007 validation scenario (not official population/facility placement or balance)",
    country_mobilized_manpower: 30000,
    is_bankrupt: false,
    stockpile: {
        Iron: 2000.0,
        Coal: 2000.0,
        Food: 100.0,
    },
    states: [
        // 20: 施設あり・失業者あり(労働力 300000、必要労働力 58000)
        (
            state: 20,
            population: 600000,
            workforce_ratio: 0.5,
            base_logistics_capacity: 100.0,
            buildings: { Farm: 3, Mine: 2, Factory: 1, Railway: 1 },
            resource_deposits: [
                (resource_type: Iron, base_output: 40.0, discovered: true, development_level: 1),
                (resource_type: Coal, base_output: 30.0, discovered: true, development_level: 1),
            ],
        ),
        // 21: 労働力不足(労働力 40000 < 必要労働力 50000)
        (
            state: 21,
            population: 100000,
            workforce_ratio: 0.4,
            base_logistics_capacity: 60.0,
            buildings: { Farm: 6, Factory: 1 },
        ),
        // 22: 施設ゼロ(全員が失業者)
        (
            state: 22,
            population: 250000,
            workforce_ratio: 0.45,
            base_logistics_capacity: 100.0,
        ),
    ],
)
